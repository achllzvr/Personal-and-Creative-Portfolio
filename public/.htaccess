# Hostinger (Apache/LiteSpeed) — static Vite SPA in public_html
# Vite copies this file into dist/ on every build.

RewriteEngine On

# SPA fallback: unknown paths return the app shell.
# (No client-side router today — this future-proofs history routing
#  and keeps deep links from hard-404ing.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Never cache the entry page so a new deploy is picked up immediately.
<FilesMatch "^(index\.html)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
  </IfModule>
</FilesMatch>

# Vite's bundled JS/CSS filenames are content-hashed — cache them hard.
<FilesMatch "\.(?:js|css)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

# Public images keep stable filenames — short cache so replacements show up.
<FilesMatch "\.(?:png|jpe?g|gif|svg|webp|ico)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</FilesMatch>

# Compression for text assets (no-op where LiteSpeed already handles it).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
